{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/cycles",
      "schedule": "0 3 1 * *"
    },
    {
      "path": "/api/cron/publish",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/meta-refresh",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/transcript-pull",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/metrics-collect",
      "schedule": "0 5 * * *"
    }
  ]
}
