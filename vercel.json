{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "gru1"
  ],
  "crons": [
    {
      "path": "/api/cron/cycles",
      "schedule": "0 3 1 * *"
    },
    {
      "path": "/api/cron/meta-refresh",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/metrics-collect",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/social-digest",
      "schedule": "0 11 * * 1-5"
    },
    {
      "path": "/api/cron/publish",
      "schedule": "10 11 * * *"
    }
  ]
}
