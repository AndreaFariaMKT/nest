# ───────────────────────────────────────────────────────────
# Supabase
# ───────────────────────────────────────────────────────────
# Local (supabase start): NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ───────────────────────────────────────────────────────────
# Anthropic (Claude)
# ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ───────────────────────────────────────────────────────────
# Meta (Instagram Graph API)
# ───────────────────────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_LONG_LIVED_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# ───────────────────────────────────────────────────────────
# Voyage AI (semantic memory — embeddings)
# Powers similarity search across drafts. Get a key at dash.voyageai.com.
# Without this, the content engine falls back to chronological recency.
# ───────────────────────────────────────────────────────────
VOYAGE_API_KEY=

# ───────────────────────────────────────────────────────────
# Google OAuth (Calendar + Meet)
# Set Authorized redirect URI in Google Cloud Console to match REDIRECT_URI.
# ───────────────────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/google/callback

# ───────────────────────────────────────────────────────────
# LinkedIn (posting via /rest/posts)
# Tokens come from a Community Management API approved app + 3-legged
# OAuth. ORGANIZATION_URN format: urn:li:organization:{numeric id}.
# ───────────────────────────────────────────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_URN=
LINKEDIN_API_VERSION=202403

# ───────────────────────────────────────────────────────────
# TikTok (Content Posting API)
# Inbox mode: works with unaudited apps; sends drafts to the creator's
# TikTok app for manual finalisation. Direct mode: requires audit + the
# video.publish scope. Toggle via TIKTOK_PUBLISH_MODE.
# ───────────────────────────────────────────────────────────
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_PUBLISH_MODE=inbox

# ───────────────────────────────────────────────────────────
# WhatsApp Business Cloud
# ───────────────────────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# ───────────────────────────────────────────────────────────
# App
# ───────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=

# ───────────────────────────────────────────────────────────
# Shared logins (optional — social media module)
# Encrypts the shared-login passwords so the database only ever holds
# ciphertext. 32 bytes, base64 or 64-char hex. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this makes stored passwords unreadable — re-enter them.
# ───────────────────────────────────────────────────────────
SOCIAL_SECRET_KEY=

# ───────────────────────────────────────────────────────────
# Sentry (optional — opt-in error tracking)
# Format: https://<publicKey>@<host>/<projectId>
# When set, log.error() mirrors to Sentry via a lightweight envelope fetch.
# ───────────────────────────────────────────────────────────
SENTRY_DSN=
